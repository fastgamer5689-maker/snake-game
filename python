import pygame
import random
import sys
import os
import math

pygame.init()

# --- Settings ---
CELL_SIZE = 24
GRID_WIDTH = 28
GRID_HEIGHT = 20
WIDTH = CELL_SIZE * GRID_WIDTH
HEIGHT = CELL_SIZE * GRID_HEIGHT
UI_HEIGHT = 50
RENDER_FPS = 60
MOVE_INTERVAL_MS = 140

WALLS_MODE_SNAKE_SIZE = 5

# --- Colors ---
BG_TOP = (18, 22, 30)
BG_BOTTOM = (10, 12, 18)
GRID_LINE = (28, 33, 44)
SNAKE_HEAD = (90, 220, 130)
SNAKE_BODY = (46, 160, 90)
SNAKE_OUTLINE = (20, 90, 55)
FOOD_COLOR = (230, 70, 90)
FOOD_GLOW = (120, 30, 45)
WALL_COLOR = (110, 110, 125)
WALL_OUTLINE = (70, 70, 82)
WHITE = (240, 240, 245)
DIM = (150, 155, 165)
ACCENT = (90, 220, 130)
UI_BG = (14, 16, 22)

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
HIGHSCORE_FILE = os.path.join(SCRIPT_DIR, "highscore.txt")

screen = pygame.display.set_mode((WIDTH, HEIGHT + UI_HEIGHT))
pygame.display.set_caption("Snake")
clock = pygame.time.Clock()

font_big = pygame.font.SysFont("arial", 46, bold=True)
font_med = pygame.font.SysFont("arial", 26, bold=True)
font_small = pygame.font.SysFont("arial", 20)
font_ui = pygame.font.SysFont("arial", 22, bold=True)

MODE_CLASSIC = "classic"
MODE_WALLS = "walls"
MODE_FREESTYLE = "freestyle"
MODE_GOD = "god"


def load_highscores():
    scores = {MODE_CLASSIC: 0, MODE_WALLS: 0, MODE_FREESTYLE: 0, MODE_GOD: 0}
    if os.path.exists(HIGHSCORE_FILE):
        try:
            with open(HIGHSCORE_FILE, "r") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=")
                        if k in scores:
                            scores[k] = int(v)
        except Exception:
            pass
    return scores


def save_highscores(scores):
    try:
        with open(HIGHSCORE_FILE, "w") as f:
            for k, v in scores.items():
                f.write(f"{k}={v}\n")
    except Exception:
        pass


def create_background_surface():
    bg_surface = pygame.Surface((WIDTH, HEIGHT))
    for i in range(HEIGHT):
        ratio = i / max(HEIGHT - 1, 1)
        color = tuple(int(BG_TOP[c] + (BG_BOTTOM[c] - BG_TOP[c]) * ratio) for c in range(3))
        pygame.draw.line(bg_surface, color, (0, i), (WIDTH, i))
    for x in range(0, WIDTH, CELL_SIZE):
        pygame.draw.line(bg_surface, GRID_LINE, (x, 0), (x, HEIGHT))
    for y in range(0, HEIGHT, CELL_SIZE):
        pygame.draw.line(bg_surface, GRID_LINE, (0, y), (WIDTH, y))
    return bg_surface


BACKGROUND_SURFACE = create_background_surface()


def draw_rounded_cell(pos, color, outline=None, radius=6, inset=1):
    rect = pygame.Rect(
        pos[0] * CELL_SIZE + inset,
        UI_HEIGHT + pos[1] * CELL_SIZE + inset,
        CELL_SIZE - inset * 2,
        CELL_SIZE - inset * 2,
    )
    pygame.draw.rect(screen, color, rect, border_radius=radius)
    if outline:
        pygame.draw.rect(screen, outline, rect, width=2, border_radius=radius)


def draw_snake(snake, direction):
    for segment in snake[1:]:
        draw_rounded_cell(segment, SNAKE_BODY, SNAKE_OUTLINE, radius=7)

    head = snake[0]
    draw_rounded_cell(head, SNAKE_HEAD, SNAKE_OUTLINE, radius=9)

    cx = head[0] * CELL_SIZE + CELL_SIZE // 2
    cy = UI_HEIGHT + head[1] * CELL_SIZE + CELL_SIZE // 2
    offset = CELL_SIZE // 4
    eye_r = max(3, CELL_SIZE // 6)

    dx, dy = direction
    if dx > 0:
        eye_positions = [(cx + offset, cy - offset), (cx + offset, cy + offset)]
    elif dx < 0:
        eye_positions = [(cx - offset, cy - offset), (cx - offset, cy + offset)]
    elif dy > 0:
        eye_positions = [(cx - offset, cy + offset), (cx + offset, cy + offset)]
    else:
        eye_positions = [(cx - offset, cy - offset), (cx + offset, cy - offset)]

    for ex, ey in eye_positions:
        pygame.draw.circle(screen, WHITE, (ex, ey), eye_r)
        pygame.draw.circle(screen, (10, 10, 10), (ex, ey), max(1, eye_r // 2))


def draw_freestyle_snake(snake_pts, angle):
    for pt in snake_pts[1:]:
        rect = pygame.Rect(pt[0] - CELL_SIZE//2 + 1, UI_HEIGHT + pt[1] - CELL_SIZE//2 + 1, CELL_SIZE - 2, CELL_SIZE - 2)
        pygame.draw.rect(screen, SNAKE_BODY, rect, border_radius=7)
        pygame.draw.rect(screen, SNAKE_OUTLINE, rect, width=2, border_radius=7)

    if snake_pts:
        head = snake_pts[0]
        rect = pygame.Rect(head[0] - CELL_SIZE//2 + 1, UI_HEIGHT + head[1] - CELL_SIZE//2 + 1, CELL_SIZE - 2, CELL_SIZE - 2)
        pygame.draw.rect(screen, SNAKE_HEAD, rect, border_radius=9)
        pygame.draw.rect(screen, SNAKE_OUTLINE, rect, width=2, border_radius=9)

        cx = head[0]
        cy = UI_HEIGHT + head[1]
        rad = math.radians(angle)
        cos_a = math.cos(rad)
        sin_a = math.sin(rad)
        offset = CELL_SIZE // 4
        eye_r = max(3, CELL_SIZE // 6)

        ex1 = cx + cos_a * (CELL_SIZE//4) - sin_a * (CELL_SIZE//4)
        ey1 = cy + sin_a * (CELL_SIZE//4) + cos_a * (CELL_SIZE//4)
        ex2 = cx + cos_a * (CELL_SIZE//4) + sin_a * (CELL_SIZE//4)
        ey2 = cy + sin_a * (CELL_SIZE//4) - cos_a * (CELL_SIZE//4)

        for ex, ey in [(ex1, ey1), (ex2, ey2)]:
            pygame.draw.circle(screen, WHITE, (int(ex), int(ey)), eye_r)
            pygame.draw.circle(screen, (10, 10, 10), (int(ex), int(ey)), max(1, eye_r // 2))


def draw_food(food, pulse):
    cx = food[0] * CELL_SIZE + CELL_SIZE // 2
    cy = UI_HEIGHT + food[1] * CELL_SIZE + CELL_SIZE // 2
    glow_r = CELL_SIZE // 2 + 3 + pulse
    pygame.draw.circle(screen, FOOD_GLOW, (cx, cy), glow_r)
    pygame.draw.circle(screen, FOOD_COLOR, (cx, cy), CELL_SIZE // 2 - 2)


def draw_walls(walls):
    for w in walls:
        draw_rounded_cell(w, WALL_COLOR, WALL_OUTLINE, radius=3, inset=0)


class UICache:
    def __init__(self):
        self.last_score = -1
        self.last_high = -1
        self.score_surf = None
        self.high_surf = None

    def draw(self, score, high_score, mode_label):
        pygame.draw.rect(screen, UI_BG, (0, 0, WIDTH, UI_HEIGHT))
        pygame.draw.line(screen, GRID_LINE, (0, UI_HEIGHT), (WIDTH, UI_HEIGHT), 2)

        if score != self.last_score:
            self.score_surf = font_ui.render(f"Score: {score}", True, WHITE)
            self.last_score = score

        if high_score != self.last_high:
            self.high_surf = font_ui.render(f"Best: {high_score}", True, ACCENT)
            self.last_high = high_score

        screen.blit(self.score_surf, (14, UI_HEIGHT // 2 - self.score_surf.get_height() // 2))
        screen.blit(self.high_surf, (WIDTH // 2 - self.high_surf.get_width() // 2, UI_HEIGHT // 2 - self.high_surf.get_height() // 2))

        mode_surf = font_small.render(mode_label, True, DIM)
        screen.blit(mode_surf, (WIDTH - mode_surf.get_width() - 14, UI_HEIGHT // 2 - mode_surf.get_height() // 2))


def center_text(text, font, color, y):
    surf = font.render(text, True, color)
    rect = surf.get_rect(center=(WIDTH // 2, y))
    screen.blit(surf, rect)


def random_free_cell(occupied):
    while True:
        pos = (random.randint(0, GRID_WIDTH - 1), random.randint(0, GRID_HEIGHT - 1))
        if pos not in occupied:
            return pos


def show_menu(high_scores):
    options = [
        ("Classic", MODE_CLASSIC, "Grow as you eat. Avoid arena edges and yourself."),
        ("Walls", MODE_WALLS, "Fixed size. One permanent wall spawns per fruit."),
        ("Free Style", MODE_FREESTYLE, "Mouse-guided smooth movement with spawning walls."),
        ("God Mode", MODE_GOD, "Easy mode. Teleports through walls, cannot die."),
    ]
    selected_idx = 0

    while True:
        mouse_pos = pygame.mouse.get_pos()
        
        left_arrow_rect = pygame.Rect(WIDTH // 2 - 200, UI_HEIGHT + 185, 40, 50)
        right_arrow_rect = pygame.Rect(WIDTH // 2 + 160, UI_HEIGHT + 185, 40, 50)
        play_button_rect = pygame.Rect(WIDTH // 2 - 100, UI_HEIGHT + 310, 200, 50)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key in (pygame.K_LEFT, pygame.K_a):
                    selected_idx = (selected_idx - 1) % len(options)
                elif event.key in (pygame.K_RIGHT, pygame.K_d):
                    selected_idx = (selected_idx + 1) % len(options)
                elif event.key in (pygame.K_RETURN, pygame.K_SPACE):
                    return options[selected_idx][1]
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:
                    if left_arrow_rect.collidepoint(mouse_pos):
                        selected_idx = (selected_idx - 1) % len(options)
                    elif right_arrow_rect.collidepoint(mouse_pos):
                        selected_idx = (selected_idx + 1) % len(options)
                    elif play_button_rect.collidepoint(mouse_pos):
                        return options[selected_idx][1]

        screen.blit(BACKGROUND_SURFACE, (0, UI_HEIGHT))
        pygame.draw.rect(screen, UI_BG, (0, 0, WIDTH, UI_HEIGHT))
        center_text("SNAKE", font_big, ACCENT, UI_HEIGHT + 70)
        center_text("Select Game Mode", font_small, DIM, UI_HEIGHT + 115)

        box_rect = pygame.Rect(WIDTH // 2 - 150, UI_HEIGHT + 170, 300, 85)
        pygame.draw.rect(screen, (22, 24, 30), box_rect, border_radius=12)
        pygame.draw.rect(screen, ACCENT, box_rect, width=2, border_radius=12)

        label, mode_key, desc = options[selected_idx]
        center_text(label, font_med, WHITE, UI_HEIGHT + 200)
        center_text(desc, font_small, DIM, UI_HEIGHT + 275)

        left_color = ACCENT if left_arrow_rect.collidepoint(mouse_pos) else WHITE
        right_color = ACCENT if right_arrow_rect.collidepoint(mouse_pos) else WHITE
        
        surf_l = font_med.render("<", True, left_color)
        screen.blit(surf_l, surf_l.get_rect(center=left_arrow_rect.center))

        surf_r = font_med.render(">", True, right_color)
        screen.blit(surf_r, surf_r.get_rect(center=right_arrow_rect.center))

        play_hover = play_button_rect.collidepoint(mouse_pos)
        play_bg = (30, 50, 38) if play_hover else (22, 36, 28)
        pygame.draw.rect(screen, play_bg, play_button_rect, border_radius=10)
        pygame.draw.rect(screen, ACCENT, play_button_rect, width=2, border_radius=10)
        center_text("PLAY", font_med, ACCENT, UI_HEIGHT + 335)

        center_text("Arrows/A-D to select, Enter or Click Play to start", font_small, DIM, HEIGHT + UI_HEIGHT - 25)

        pygame.display.flip()
        clock.tick(30)


def run_game(mode, high_scores):
    if mode == MODE_FREESTYLE:
        start_x = WIDTH // 2
        start_y = HEIGHT // 2
        snake_pts = [(start_x - i * 15, start_y) for i in range(WALLS_MODE_SNAKE_SIZE)]
        speed = 4.2
        vx = speed
        vy = 0.0
        angle = 0.0
        walls = set()
        food = random_free_cell({(int(pt[0]) // CELL_SIZE, int(pt[1]) // CELL_SIZE) for pt in snake_pts})
    else:
        if mode == MODE_WALLS:
            start_len = WALLS_MODE_SNAKE_SIZE
            start_x = GRID_WIDTH // 2
            start_y = GRID_HEIGHT // 2
            snake = [(start_x - i, start_y) for i in range(start_len)]
        else:
            snake = [(GRID_WIDTH // 2, GRID_HEIGHT // 2)]

        direction = (1, 0)
        pending_direction = direction
        food = random_free_cell(set(snake))
        walls = set()

    score = 0
    game_over = False
    paused = False
    pulse = 0
    pulse_dir = 1

    ui_cache = UICache()
    last_move_time = pygame.time.get_ticks()
    last_mouse_pos = pygame.mouse.get_pos()

    while True:
        current_time = pygame.time.get_ticks()
        mouse_pos = pygame.mouse.get_pos()

        resume_btn_rect = pygame.Rect(WIDTH // 2 - 110, UI_HEIGHT + HEIGHT // 2 - 20, 220, 45)
        menu_btn_rect = pygame.Rect(WIDTH // 2 - 110, UI_HEIGHT + HEIGHT // 2 + 35, 220, 45)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_p:
                    if not game_over:
                        paused = not paused
                elif not paused and not game_over and mode != MODE_FREESTYLE:
                    if event.key in (pygame.K_UP, pygame.K_w) and direction != (0, 1):
                        pending_direction = (0, -1)
                    elif event.key in (pygame.K_DOWN, pygame.K_s) and direction != (0, -1):
                        pending_direction = (0, 1)
                    elif event.key in (pygame.K_LEFT, pygame.K_a) and direction != (1, 0):
                        pending_direction = (-1, 0)
                    elif event.key in (pygame.K_RIGHT, pygame.K_d) and direction != (-1, 0):
                        pending_direction = (1, 0)

                if event.key == pygame.K_r and game_over:
                    return "restart"
                elif event.key == pygame.K_m and (game_over or paused):
                    return "menu"
                elif event.key == pygame.K_ESCAPE:
                    if paused:
                        paused = False
                    else:
                        pygame.quit()
                        sys.exit()

            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                if paused:
                    if resume_btn_rect.collidepoint(mouse_pos):
                        paused = False
                    elif menu_btn_rect.collidepoint(mouse_pos):
                        return "menu"

        if not game_over and not paused:
            if mode == MODE_FREESTYLE:
                head_x, head_y = snake_pts[0]
                target_x = mouse_pos[0]
                target_y = mouse_pos[1] - UI_HEIGHT

                if mouse_pos != last_mouse_pos:
                    dx = target_x - head_x
                    dy = target_y - head_y
                    dist_to_mouse = math.hypot(dx, dy)

                    if dist_to_mouse > 2:
                        angle = math.degrees(math.atan2(dy, dx))
                        vx = (dx / dist_to_mouse) * speed
                        vy = (dy / dist_to_mouse) * speed
                    last_mouse_pos = mouse_pos

                new_head = (head_x + vx, head_y + vy)
                head_grid = (int(new_head[0]) // CELL_SIZE, int(new_head[1]) // CELL_SIZE)

                if (new_head[0] < 0 or new_head[0] >= WIDTH or 
                    new_head[1] < 0 or new_head[1] >= HEIGHT or 
                    head_grid in walls):
                    game_over = True
                else:
                    snake_pts.insert(0, new_head)
                    fx_px = food[0] * CELL_SIZE + CELL_SIZE // 2
                    fy_px = food[1] * CELL_SIZE + CELL_SIZE // 2
                    dist_to_food = math.hypot(new_head[0] - fx_px, new_head[1] - fy_px)
                    
                    if dist_to_food < CELL_SIZE // 2 + 6:
                        score += 1
                        occupied_grid = {(int(pt[0]) // CELL_SIZE, int(pt[1]) // CELL_SIZE) for pt in snake_pts} | walls | {food}
                        if len(occupied_grid) < GRID_WIDTH * GRID_HEIGHT:
                            new_wall = random_free_cell(occupied_grid)
                            walls.add(new_wall)
                        food = random_free_cell({(int(pt[0]) // CELL_SIZE, int(pt[1]) // CELL_SIZE) for pt in snake_pts} | walls)
                    else:
                        snake_pts.pop()

                    for pt in snake_pts[10:]:
                        if math.hypot(new_head[0] - pt[0], new_head[1] - pt[1]) < CELL_SIZE // 2:
                            game_over = True

                    if game_over and score > high_scores[mode]:
                        high_scores[mode] = score
                        save_highscores(high_scores)

            elif current_time - last_move_time >= MOVE_INTERVAL_MS:
                last_move_time = current_time
                direction = pending_direction
                head = (snake[0][0] + direction[0], snake[0][1] + direction[1])

                if mode == MODE_GOD:
                    wrapped_x = head[0] % GRID_WIDTH
                    wrapped_y = head[1] % GRID_HEIGHT
                    head = (wrapped_x, wrapped_y)
                    snake.insert(0, head)
                    if head == food:
                        score += 1
                        occupied = set(snake) | walls
                        food = random_free_cell(occupied)
                    else:
                        snake.pop()
                else:
                    hit_wall_boundary = head[0] < 0 or head[0] >= GRID_WIDTH or head[1] < 0 or head[1] >= GRID_HEIGHT
                    hit_self = head in snake
                    hit_obstacle = head in walls

                    if hit_wall_boundary or hit_self or hit_obstacle:
                        game_over = True
                        if score > high_scores[mode]:
                            high_scores[mode] = score
                            save_highscores(high_scores)
                    else:
                        snake.insert(0, head)
                        ate = head == food
                        if ate:
                            score += 1
                            if mode == MODE_WALLS:
                                snake.pop()
                                occupied = set(snake) | walls | {food}
                                if len(occupied) < GRID_WIDTH * GRID_HEIGHT:
                                    new_wall = random_free_cell(occupied)
                                    walls.add(new_wall)
                                food = random_free_cell(set(snake) | walls)
                            else:
                                occupied = set(snake)
                                food = random_free_cell(occupied)
                        else:
                            snake.pop()

        # --- Draw ---
        screen.blit(BACKGROUND_SURFACE, (0, UI_HEIGHT))
        if mode in (MODE_WALLS, MODE_FREESTYLE):
            draw_walls(walls)
        draw_food(food, pulse)

        if mode == MODE_FREESTYLE:
            draw_freestyle_snake(snake_pts, angle)
        else:
            draw_snake(snake, direction)

        mode_labels = {
            MODE_CLASSIC: "Classic",
            MODE_WALLS: "Walls",
            MODE_FREESTYLE: "Free Style",
            MODE_GOD: "God Mode"
        }
        ui_cache.draw(score, high_scores[mode], mode_labels[mode])

        if game_over:
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 165))
            screen.blit(overlay, (0, UI_HEIGHT))

            center_text("GAME OVER", font_big, (230, 80, 90), UI_HEIGHT + HEIGHT // 2 - 50)
            center_text(f"Score: {score}", font_med, WHITE, UI_HEIGHT + HEIGHT // 2)
            if score >= high_scores[mode] and score > 0:
                center_text("New high score!", font_small, ACCENT, UI_HEIGHT + HEIGHT // 2 + 30)
            center_text("R to restart   /   M for menu", font_small, DIM, UI_HEIGHT + HEIGHT // 2 + 65)

        elif paused:
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 165))
            screen.blit(overlay, (0, UI_HEIGHT))

            center_text("PAUSED", font_big, WHITE, UI_HEIGHT + HEIGHT // 2 - 65)

            res_hover = resume_btn_rect.collidepoint(mouse_pos)
            res_bg = (30, 50, 38) if res_hover else (22, 36, 28)
            pygame.draw.rect(screen, res_bg, resume_btn_rect, border_radius=8)
            pygame.draw.rect(screen, ACCENT, resume_btn_rect, width=2, border_radius=8)
            center_text("Resume", font_small, WHITE, resume_btn_rect.centery)

            menu_hover = menu_btn_rect.collidepoint(mouse_pos)
            menu_bg = (50, 30, 30) if menu_hover else (36, 22, 22)
            pygame.draw.rect(screen, menu_bg, menu_btn_rect, border_radius=8)
            pygame.draw.rect(screen, (230, 80, 90), menu_btn_rect, width=2, border_radius=8)
            center_text("Main Menu", font_small, (230, 80, 90), menu_btn_rect.centery)

        pulse += pulse_dir
        if pulse > 4 or pulse < 0:
            pulse_dir *= -1

        pygame.display.flip()
        clock.tick(RENDER_FPS)


def main():
    high_scores = load_highscores()
    while True:
        mode = show_menu(high_scores)
        result = "restart"
        while result == "restart":
            result = run_game(mode, high_scores)


if __name__ == "__main__":
    main()